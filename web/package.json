{
  "name": "plenarywire-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "predev": "npm run sync",
    "dev": "next dev",
    "prebuild": "npm run sync",
    "build": "next build",
    "test": "npm run sync && esbuild tests/ingest.test.ts --bundle --platform=node --format=esm --outfile=.test-out/ingest.test.mjs --log-level=warning && node --test .test-out/ingest.test.mjs",
    "cf:build": "npm run sync && opennextjs-cloudflare build",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply newsdesk-24 --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
